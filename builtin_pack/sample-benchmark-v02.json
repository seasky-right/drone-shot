{
  "benchmark_id": "builtin-v02-benchmark",
  "benchmark": {"id": "drone.v02.mock/benchmark"},
  "processor": {"id": "drone.v02.mock/processor"},
  "components": {
    "backend": {"id": "drone.v02.mock/backend"},
    "generator": {"id": "drone.v02.mock/generator"},
    "task": {"id": "drone.v02.mock/task"},
    "evaluator": {"id": "drone.v02.mock/evaluator"},
    "agents": {"central": {"id": "drone.v02.mock/agent", "config": {"target_north_m": 5}}}
