{
  "seed": 7,
  "components": {
    "backend": {"id": "sample.spatial-search/backend"},
    "generator": {"id": "sample.spatial-search/generator"},
    "task": {"id": "sample.spatial/task.search-target", "config": {"tolerance_m": 0.75}},
    "evaluator": {"id": "sample.spatial/evaluator.search-target", "config": {"tolerance_m": 0.75, "missing_penalty_m": 100.0}},
    "agents": {
      "pilot": {
        "id": "drone.agent.spatial_search/agent",
        "config": {
          "lane_spacing_m": 2.0,
          "min_confidence": 0.5,
          "waypoint_tolerance_m": 0.3
        }
      }
    }
  },
  "vehicles": ["A"],
  "bindings": [{"agent_id": "pilot", "vehicle_ids": ["A"]}],
  "required_action_kinds": ["spatial/move-to", "spatial/report-target"],
  "action_schemas": {
    "spatial/move-to": "spatial.move-to/v1",
    "spatial/report-target": "spatial.report-target/v1"
  },
  "payload_schemas": {
    "spatial/move-to": {
      "type": "object",
      "required": ["north_m", "east_m", "down_m"],
      "properties": {
        "north_m": {"type": "number"},
        "east_m": {"type": "number"},
        "down_m": {"type": "number"}
      },
      "additionalProperties": false
    },
    "spatial/report-target": {
      "type": "object",
      "required": ["target_id", "north_m", "east_m", "down_m"],
      "properties": {
        "target_id": {"type": "string"},
        "north_m": {"type": "number"},
        "east_m": {"type": "number"},
        "down_m": {"type": "number"}
      },
      "additionalProperties": false
    }
  },
  "max_steps": 12
}
